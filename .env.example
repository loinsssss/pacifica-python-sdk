# Copy to .env for mainnet, or .env.testnet and set PACIFICA_MAINNET=false.
# Clients never load files implicitly; examples and load_environment select them explicitly.
PACIFICA_MAINNET=true
PACIFICA_ACCOUNT=
# Base58 Solana 64-byte keypair, preferably an already-bound agent key.
PACIFICA_SIGNER_PRIVATE_KEY=
# Set when signing with an agent; leave blank for the owner wallet.
PACIFICA_AGENT_WALLET=
# Optional quota/configuration key; does not authorize trading.
PACIFICA_API_CONFIG_KEY=
# Optional transport overrides. Standard environment endpoints are built in.
PACIFICA_BASE_URL=
PACIFICA_WEBSOCKET_URL=
